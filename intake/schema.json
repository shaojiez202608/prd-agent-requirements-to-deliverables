{
  "schema_version": "1.0",
  "variants": {
    "frontline": {"title_en": "Frontline intake", "title_zh": "一线版录入"},
    "pm": {"title_en": "PM intake", "title_zh": "PM 版录入"}
  },
  "sections": [
    {
      "key": "business",
      "title_en": "1. Business scenario",
      "title_zh": "1. 业务场景",
      "fields": [
        {"key": "scene_category", "type": "enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Scene category", "label_zh": "场景类别",
         "options": [
           {"value": "industrial_monitoring", "en": "Industrial monitoring", "zh": "工业监控"},
           {"value": "smart_home", "en": "Smart home", "zh": "智能家居"},
           {"value": "shared_device", "en": "Shared device", "zh": "共享设备"},
           {"value": "agriculture_monitoring", "en": "Agriculture monitoring", "zh": "农业监测"},
           {"value": "device_testing", "en": "Device testing", "zh": "设备检测"},
           {"value": "other", "en": "Other", "zh": "其他"}
         ], "example": "smart_home"},
        {"key": "scene_description", "type": "text", "required": true, "variants": ["frontline", "pm"], "max_length": 300,
         "label_en": "Scene description (one sentence)", "label_zh": "场景描述（一句话）",
         "example": "Households want to switch appliances remotely and see power draw."},
        {"key": "pain_points", "type": "multi_enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Pain points", "label_zh": "要解决的痛点",
         "options": [
           {"value": "remote_monitoring_hard", "en": "Remote monitoring is hard", "zh": "远程监控难"},
           {"value": "high_manual_maintenance", "en": "High manual maintenance cost", "zh": "人工维护成本高"},
           {"value": "data_not_aggregated", "en": "Data cannot be aggregated", "zh": "数据无法统计"},
           {"value": "faults_not_alerted", "en": "Faults are not alerted in time", "zh": "故障无法及时告警"},
           {"value": "coarse_energy_management", "en": "Coarse energy management", "zh": "能耗管理粗放"},
           {"value": "other", "en": "Other", "zh": "其他"}
         ], "example": ["remote_monitoring_hard", "faults_not_alerted"]},
        {"key": "end_users", "type": "multi_enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "End users", "label_zh": "最终用户",
         "options": [
           {"value": "operations_staff", "en": "Operations staff", "zh": "运维人员"},
           {"value": "consumers", "en": "Consumers", "zh": "普通消费者"},
           {"value": "factory_admins", "en": "Factory administrators", "zh": "工厂管理员"},
           {"value": "after_sales_staff", "en": "After-sales staff", "zh": "售后人员"},
           {"value": "other", "en": "Other", "zh": "其他"}
         ], "example": ["consumers"]}
      ]
    },
    {
      "key": "hardware",
      "title_en": "2. Hardware and device side",
      "title_zh": "2. 硬件端侧",
      "fields": [
        {"key": "product_category", "type": "enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Product category", "label_zh": "产品品类",
         "options": [
           {"value": "smart_plug", "en": "Smart plug", "zh": "智能插座"},
           {"value": "smart_light", "en": "Smart light", "zh": "智能照明"},
           {"value": "environment_sensor", "en": "Environment sensor", "zh": "环境传感器"},
           {"value": "gateway", "en": "Gateway", "zh": "网关"},
           {"value": "controller", "en": "Controller", "zh": "控制器"},
           {"value": "other", "en": "Other", "zh": "其他"}
         ], "example": "smart_plug"},
        {"key": "product_name", "type": "text", "required": true, "variants": ["frontline", "pm"], "max_length": 64,
         "label_en": "Product working name (fictional or internal-neutral)", "label_zh": "产品工作名（中性名称）",
         "example": "Demo Smart Plug"},
        {"key": "connectivity", "type": "enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Connectivity", "label_zh": "联网方式",
         "options": [
           {"value": "wifi", "en": "Wi-Fi", "zh": "Wi-Fi"},
           {"value": "wifi_ble", "en": "Wi-Fi + BLE", "zh": "Wi-Fi + 蓝牙"},
           {"value": "ble", "en": "BLE only", "zh": "仅蓝牙"},
           {"value": "cellular", "en": "Cellular", "zh": "蜂窝网络"},
           {"value": "ethernet", "en": "Ethernet", "zh": "以太网"}
         ], "example": "wifi"},
        {"key": "power_supply", "type": "enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Power supply", "label_zh": "供电方式",
         "options": [
           {"value": "mains", "en": "Mains", "zh": "市电"},
           {"value": "battery", "en": "Battery", "zh": "电池"},
           {"value": "usb", "en": "USB", "zh": "USB"}
         ], "example": "mains"},
        {"key": "architecture_mode", "type": "enum", "required": true, "variants": ["pm"],
         "label_en": "Device architecture", "label_zh": "端侧架构",
         "options": [
           {"value": "single_chip_module", "en": "Single-chip (application runs on the connectivity module)", "zh": "单芯片（应用跑在通信模组上）"},
           {"value": "mcu_plus_module", "en": "Host MCU + connectivity module", "zh": "主控 MCU + 通信模组"}
         ], "example": "single_chip_module"},
        {"key": "module_selection", "type": "enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Module selection status", "label_zh": "设备选型状态",
         "options": [
           {"value": "selected", "en": "Selected (record a neutral placeholder name only)", "zh": "已选型（只写中性占位名）"},
           {"value": "to_be_decided", "en": "To be decided", "zh": "待定"}
         ], "example": "to_be_decided"},
        {"key": "firmware_custom", "type": "enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Firmware", "label_zh": "固件是否定制",
         "options": [
           {"value": "standard", "en": "Standard firmware", "zh": "标准固件"},
           {"value": "custom", "en": "Custom firmware", "zh": "定制固件"}
         ], "example": "custom"},
        {"key": "channels", "type": "integer", "required": false, "variants": ["pm"], "min": 1, "max": 16,
         "label_en": "Number of channels", "label_zh": "路数", "example": 1}
      ]
    },
    {
      "key": "thing_model",
      "title_en": "3. Functions and thing model",
      "title_zh": "3. 功能物模型",
      "fields": [
        {"key": "properties", "type": "properties", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Properties (one row per function point)", "label_zh": "属性（每个功能点一行）",
         "columns": [
           {"key": "name", "type": "text", "required": true, "variants": ["frontline", "pm"], "max_length": 40,
            "label_en": "Control / function name", "label_zh": "控件/功能名", "example": "Power switch"},
           {"key": "id", "type": "integer", "required": true, "variants": ["pm"], "min": 1, "max": 9999,
            "label_en": "ID", "label_zh": "ID", "example": 1},
           {"key": "identifier", "type": "text", "required": true, "variants": ["pm"], "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "label_en": "Identifier", "label_zh": "标识符", "example": "power_switch"},
           {"key": "data_type", "type": "enum", "required": true, "variants": ["pm"],
            "label_en": "Data type", "label_zh": "数据类型",
            "options": [
              {"value": "bool", "en": "bool", "zh": "布尔"},
              {"value": "int", "en": "int", "zh": "整数"},
              {"value": "float", "en": "float", "zh": "浮点"},
              {"value": "enum", "en": "enum", "zh": "枚举"},
              {"value": "string", "en": "string", "zh": "字符串"}
            ], "example": "bool"},
           {"key": "access", "type": "enum", "required": true, "variants": ["frontline", "pm"],
            "label_en": "Access", "label_zh": "读写",
            "options": [
              {"value": "R", "en": "R (report only)", "zh": "R（只上报）"},
              {"value": "RW", "en": "RW (report and command)", "zh": "RW（可上报可下发）"},
              {"value": "W", "en": "W (command only)", "zh": "W（只下发）"}
            ], "example": "RW"},
           {"key": "unit", "type": "text", "required": false, "variants": ["pm"], "max_length": 16,
            "label_en": "Unit (int/float)", "label_zh": "单位（数值型必填）", "example": "W"},
           {"key": "min", "type": "number", "required": false, "variants": ["pm"],
            "label_en": "Min (int/float)", "label_zh": "最小值", "example": 0},
           {"key": "max", "type": "number", "required": false, "variants": ["pm"],
            "label_en": "Max (int/float)", "label_zh": "最大值", "example": 100},
           {"key": "step", "type": "number", "required": false, "variants": ["pm"],
            "label_en": "Step (int/float)", "label_zh": "步长", "example": 1},
           {"key": "enum_values", "type": "text", "required": false, "variants": ["pm"], "max_length": 200,
            "label_en": "Enum values (comma separated, enum only)", "label_zh": "枚举值（逗号分隔）", "example": "low,medium,high"},
           {"key": "max_length", "type": "integer", "required": false, "variants": ["pm"], "min": 1, "max": 4096,
            "label_en": "Max length (string only)", "label_zh": "最大长度（字符串）", "example": 255},
           {"key": "control", "type": "enum", "required": true, "variants": ["frontline", "pm"],
            "label_en": "Panel control", "label_zh": "面板控件",
            "options": [
              {"value": "toggle", "en": "Toggle", "zh": "开关"},
              {"value": "value_display", "en": "Value display", "zh": "数值展示"},
              {"value": "alarm_indicator", "en": "Alarm indicator", "zh": "告警指示"},
              {"value": "slider", "en": "Slider", "zh": "滑块"},
              {"value": "selector", "en": "Selector", "zh": "选择器"},
              {"value": "list_editor", "en": "List editor", "zh": "列表编辑"},
              {"value": "text_display", "en": "Text display", "zh": "文本展示"}
            ], "example": "toggle"},
           {"key": "interaction", "type": "text", "required": true, "variants": ["frontline", "pm"], "max_length": 120,
            "label_en": "Interaction", "label_zh": "交互行为", "example": "Tap to toggle; command/report loop"}
         ]}
      ]
    },
    {
      "key": "app",
      "title_en": "4. Cloud panel and application side",
      "title_zh": "4. 云端面板与应用侧",
      "fields": [
        {"key": "app_types", "type": "multi_enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Client application types", "label_zh": "端应用类型",
         "options": [
           {"value": "mobile_app", "en": "Mobile app", "zh": "手机 App"},
           {"value": "mini_program", "en": "Mini program", "zh": "小程序"},
           {"value": "web_console", "en": "Web admin console", "zh": "Web 管理后台"},
           {"value": "pc_client", "en": "PC client", "zh": "PC 客户端"},
           {"value": "dashboard_screen", "en": "Large-screen dashboard", "zh": "大屏看板"}
         ], "example": ["mobile_app"]},
        {"key": "provisioning", "type": "multi_enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Network provisioning", "label_zh": "配网方式",
         "options": [
           {"value": "qr_code", "en": "QR code", "zh": "扫码"},
           {"value": "softap_hotspot", "en": "Hotspot (SoftAP)", "zh": "热点"},
           {"value": "smartconfig", "en": "SmartConfig", "zh": "SmartConfig"},
           {"value": "ble_assisted", "en": "BLE-assisted", "zh": "蓝牙辅助配网"}
         ], "example": ["softap_hotspot", "ble_assisted"]},
        {"key": "login", "type": "multi_enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Login methods", "label_zh": "登录方式",
         "options": [
           {"value": "phone_otp", "en": "Phone number + one-time code", "zh": "手机号验证码"},
           {"value": "email", "en": "Email", "zh": "邮箱"},
           {"value": "one_tap", "en": "One-tap login", "zh": "一键登录"},
           {"value": "sso", "en": "SSO", "zh": "SSO"}
         ], "example": ["email"]},
        {"key": "panel_style", "type": "enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Panel style", "label_zh": "面板风格",
         "options": [
           {"value": "vivid", "en": "Vivid", "zh": "炫彩"},
           {"value": "minimal", "en": "Minimal", "zh": "极简"}
         ], "example": "minimal"},
        {"key": "data_presentation", "type": "multi_enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Data presentation", "label_zh": "数据呈现方式",
         "options": [
           {"value": "generic_properties", "en": "Generic property list", "zh": "通用属性展示"},
           {"value": "statistics_charts", "en": "Statistics charts", "zh": "统计图展示"},
           {"value": "buttons_with_animation", "en": "Buttons with animation", "zh": "按键加动效展示"}
         ], "example": ["generic_properties", "statistics_charts"]}
      ]
    },
    {
      "key": "constraints",
      "title_en": "5. Constraints and acceptance",
      "title_zh": "5. 约束与验收",
      "fields": [
        {"key": "offline_behavior", "type": "text", "required": true, "variants": ["pm"], "max_length": 300,
         "label_en": "Behaviour when the device is offline", "label_zh": "设备离线时的行为",
         "example": "Panel greys out writable controls and shows last reported values with timestamp."},
        {"key": "acceptance_criteria", "type": "lines", "required": true, "variants": ["frontline", "pm"], "max_items": 20, "max_length": 200,
         "label_en": "Acceptance criteria (one per line)", "label_zh": "验收标准（每行一条）",
         "example": "Switch command is reflected in the panel after the device reports the new state."},
        {"key": "security_privacy_notes", "type": "text", "required": false, "variants": ["pm"], "max_length": 300,
         "label_en": "Security / privacy notes", "label_zh": "安全与隐私说明", "example": "No personal data stored on the device."},
        {"key": "open_notes", "type": "text", "required": false, "variants": ["frontline", "pm"], "max_length": 300,
         "label_en": "Other notes", "label_zh": "其他备注", "example": ""}
      ]
    },
    {
      "key": "deliverables",
      "title_en": "6. Deliverables to produce",
      "title_zh": "6. 需要输出的交付物",
      "fields": [
        {"key": "outputs", "type": "multi_enum", "required": true, "variants": ["frontline", "pm"],
         "label_en": "Deliverables", "label_zh": "交付物",
         "options": [
           {"value": "thing_model", "en": "Thing model (JSON)", "zh": "物模型文件（JSON）"},
           {"value": "architecture", "en": "Product architecture diagram (mermaid)", "zh": "产品架构图（mermaid）"},
           {"value": "quick_start", "en": "Quick-start integration guide (Markdown -> PDF)", "zh": "快速接入文档（Markdown 生成 PDF）"},
           {"value": "prd", "en": "Requirements specification / PRD (Markdown)", "zh": "需求规格说明书 / PRD（Markdown）"},
           {"value": "panel_spec", "en": "Panel interaction spec (Markdown + HTML)", "zh": "面板交互说明与样式（Markdown / HTML）"},
           {"value": "device_demo", "en": "Device-side demo skeleton (C)", "zh": "设备端 Demo 骨架（C 代码）"}
         ], "example": ["thing_model", "architecture", "quick_start", "prd", "panel_spec", "device_demo"]}
      ]
    }
  ],
  "rules": {
    "numeric_types": ["int", "float"],
    "required_outputs": ["thing_model"],
    "reserved_text": ["<!--", "-->", "*/"],
    "latin1_text": {"when_output": "quick_start",
                    "fields": ["hardware.product_name", "constraints.offline_behavior"],
                    "columns": ["name", "unit", "enum_values", "interaction"]},
    "control_requirements": {
      "toggle": {"data_types": ["bool"], "access": ["RW", "W"]},
      "value_display": {"data_types": ["int", "float"], "access": ["R"]},
      "alarm_indicator": {"data_types": ["bool", "enum"], "access": ["R"]},
      "slider": {"data_types": ["int", "float"], "access": ["RW", "W"]},
      "selector": {"data_types": ["enum"], "access": ["RW", "W"]},
      "list_editor": {"data_types": ["string"], "access": ["RW", "W"]},
      "text_display": {"data_types": ["string", "enum"], "access": ["R"]}
    }
  }
}
